# Streamlit Community Cloud の「Advanced settings → Secrets」に貼る内容の例。
# ⚠️ 本物の値はこのファイルに書かず、Streamlit Cloud の管理画面にだけ入れること。
#    ローカルで試すときだけ、このファイルを .streamlit/secrets.toml にコピーして値を入れる
#    （.streamlit/secrets.toml は .gitignore 済み＝コミットされない）。

# --- 必須（デモ公開） ---
APP_PASSWORD = "ここに共有パスワード"
DEMO_MODE = "1"

# --- 任意（AIのレシート/請求書読取も試させる場合のみ・Bedrock課金あり） ---
# AWS_ACCESS_KEY_ID = "..."
# AWS_SECRET_ACCESS_KEY = "..."
# AWS_DEFAULT_REGION = "ap-northeast-1"

# ⚠️ DB_S3_BUCKET は設定しないこと（本物のS3データと繋がってしまうため）。
